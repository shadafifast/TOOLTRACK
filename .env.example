# ─── Environment Variables untuk Development ──────────────────────────────────
# Salin file ini menjadi .env.local dan isi sesuai konfigurasi server Anda.
# File .env.local TIDAK akan ter-commit ke Git (sudah di .gitignore).
#
# CARA PAKAI:
# 1. Buat file baru bernama: .env.local
# 2. Isi VITE_API_URL dengan URL Back-End Anda
# 3. Restart dev server (npm run dev)
# ─────────────────────────────────────────────────────────────────────────────

# URL dasar API Back-End
# Development lokal (ubah port sesuai Back-End Anda, misal: 8000, 3000, 5000)
VITE_API_URL=http://localhost:8000/api

# Production (uncomment dan isi saat deploy ke server)
# VITE_API_URL=https://api.tooltrack.ptsp.co.id

# Nama aplikasi (opsional, untuk ditampilkan di UI)
VITE_APP_NAME=ToolTrack QR
VITE_APP_VERSION=1.0.0
